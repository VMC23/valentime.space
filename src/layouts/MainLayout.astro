---
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Valentine Brasser" />
    <meta name="keywords" content="Valentine Brasser, Valentin:e Brasser, Multimedia Artist, Educator, Video Art, Vermittlung, documenta, Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Valentine Brasser" />
    <link rel="stylesheet" href="/global.css" />
  </head>
  <body>
    <canvas id="space-bg"></canvas>
    <canvas id="hearts-bg"></canvas>
    <nav class="nav-overlay" id="main-nav">
      <a href="/" class="nav-logo"><svg viewBox="0 0 20 20" width="24" height="24"><path d="M10 18s-1.5-1.2-3.5-3.2C4 12.3 2 9.5 2 7.5 2 5 4 3 6.5 3c1.4 0 2.7.7 3.5 1.8C10.8 3.7 12.1 3 13.5 3 16 3 18 5 18 7.5c0 2-2 4.8-4.5 7.3C11.5 16.8 10 18 10 18z" fill="#fff" fill-opacity="0.9"/></svg></a>
      <button class="nav-burger" id="nav-burger" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links" id="nav-links">
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </nav>

    <slot />

    <footer class="site-footer">
      <span>Valentine Brasser &mdash; 2026</span>
    </footer>

    <script>
      import gsap from 'gsap';

      gsap.set('#main-nav', { opacity: 0, y: -20 });
      gsap.to('#main-nav', { opacity: 1, y: 0, duration: 1, ease: 'power2.out', delay: 0.3 });

      // Mobile hamburger menu
      const burger = document.getElementById('nav-burger');
      const navLinks = document.getElementById('nav-links');
      if (burger && navLinks) {
        burger.addEventListener('click', () => {
          const isOpen = navLinks.classList.toggle('open');
          burger.classList.toggle('open', isOpen);
          burger.setAttribute('aria-expanded', String(isOpen));
        });

        // Close menu when a link is tapped
        navLinks.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            navLinks.classList.remove('open');
            burger.classList.remove('open');
            burger.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // Vibe state from localStorage
      let vibeVal = parseInt(localStorage.getItem('vibeValue') || '0') / 100;
      let vibeBgMix = vibeVal <= 0.5 ? 0 : (vibeVal - 0.5) / 0.5;

      // Listen for slider changes from index page
      window.addEventListener('vibeChange', ((e: CustomEvent) => {
        vibeVal = e.detail.value;
        vibeBgMix = vibeVal <= 0.5 ? 0 : (vibeVal - 0.5) / 0.5;
        const hb = document.getElementById('hearts-bg');
        if (hb) gsap.to(hb, { opacity: vibeVal, duration: 0.3, ease: 'power2.out', overwrite: true });
      }) as EventListener);

      // Hearts background canvas
      const heartsBg = document.getElementById('hearts-bg') as HTMLCanvasElement;
      if (heartsBg) {
        gsap.set(heartsBg, { opacity: vibeVal });
        const hctx = heartsBg.getContext('2d')!;
        let hbW = window.innerWidth, hbH = window.innerHeight;
        heartsBg.width = hbW;
        heartsBg.height = hbH;
        window.addEventListener('resize', () => {
          hbW = window.innerWidth;
          hbH = window.innerHeight;
          heartsBg.width = hbW;
          heartsBg.height = hbH;
        });

        const heartColors = [
          'rgba(245, 169, 184, ',
          'rgba(91, 206, 250, ',
          'rgba(255, 255, 255, ',
          'rgba(230, 150, 170, ',
          'rgba(120, 190, 240, ',
          'rgba(250, 185, 200, ',
          'rgba(140, 210, 245, ',
        ];

        const hearts = [];
        for (let i = 0; i < 35; i++) {
          hearts.push({
            x: Math.random() * hbW,
            y: Math.random() * hbH,
            size: Math.random() * 18 + 8,
            speed: Math.random() * 0.3 + 0.1,
            drift: Math.random() * 30 + 10,
            driftSpeed: Math.random() * 0.005 + 0.002,
            phase: Math.random() * Math.PI * 2,
            color: heartColors[Math.floor(Math.random() * heartColors.length)],
            opacity: Math.random() * 0.3 + 0.5,
            rotation: Math.random() * Math.PI * 2,
            rotSpeed: (Math.random() - 0.5) * 0.01,
          });
        }

        function drawHeartShape(ctx, cx, cy, size) {
          ctx.beginPath();
          const s = size;
          ctx.moveTo(cx, cy + s * 0.3);
          ctx.bezierCurveTo(cx, cy - s * 0.1, cx - s * 0.5, cy - s * 0.4, cx - s * 0.5, cy - s * 0.1);
          ctx.bezierCurveTo(cx - s * 0.5, cy + s * 0.15, cx, cy + s * 0.45, cx, cy + s * 0.6);
          ctx.bezierCurveTo(cx, cy + s * 0.45, cx + s * 0.5, cy + s * 0.15, cx + s * 0.5, cy - s * 0.1);
          ctx.bezierCurveTo(cx + s * 0.5, cy - s * 0.4, cx, cy - s * 0.1, cx, cy + s * 0.3);
          ctx.closePath();
          ctx.fill();
        }

        let ht = 0;
        function animateHearts() {
          ht += 0.016;
          hctx.clearRect(0, 0, hbW, hbH);

          hctx.fillStyle = '#000';
          hctx.fillRect(0, 0, hbW, hbH);

          if (vibeBgMix > 0) {
            const bgGrad = hctx.createLinearGradient(0, 0, 0, hbH);
            bgGrad.addColorStop(0, '#91d2f5');
            bgGrad.addColorStop(0.25, '#f5a9b8');
            bgGrad.addColorStop(0.5, '#ffffff');
            bgGrad.addColorStop(0.75, '#f5a9b8');
            bgGrad.addColorStop(1, '#91d2f5');
            hctx.globalAlpha = vibeBgMix;
            hctx.fillStyle = bgGrad;
            hctx.fillRect(0, 0, hbW, hbH);
            hctx.globalAlpha = 1;
          }

          hearts.forEach(h => {
            h.y -= h.speed;
            h.rotation += h.rotSpeed;
            const swayX = Math.sin(ht * h.driftSpeed * 100 + h.phase) * h.drift;
            if (h.y < -h.size * 2) {
              h.y = hbH + h.size * 2;
              h.x = Math.random() * hbW;
            }
            const drawX = h.x + swayX;

            const glow = hctx.createRadialGradient(drawX, h.y, 0, drawX, h.y, h.size * 2.5);
            glow.addColorStop(0, h.color + (h.opacity * 0.3).toFixed(2) + ')');
            glow.addColorStop(1, h.color + '0)');
            hctx.fillStyle = glow;
            hctx.beginPath();
            hctx.arc(drawX, h.y, h.size * 2.5, 0, Math.PI * 2);
            hctx.fill();

            hctx.save();
            hctx.translate(drawX, h.y);
            hctx.rotate(h.rotation);
            hctx.fillStyle = h.color + h.opacity.toFixed(2) + ')';
            drawHeartShape(hctx, 0, 0, h.size);
            hctx.restore();
          });

          requestAnimationFrame(animateHearts);
        }
        animateHearts();
      }

      // Surprise slider — dark blue nebula with stars
      let surpriseVal = parseInt(localStorage.getItem('surpriseValue') || '0') / 100;

      window.addEventListener('surpriseChange', ((e: CustomEvent) => {
        surpriseVal = e.detail.value;
        const sb = document.getElementById('space-bg');
        if (sb) gsap.to(sb, { opacity: surpriseVal, duration: 0.3, ease: 'power2.out', overwrite: true });
      }) as EventListener);

      // Space background
      const spaceBg = document.getElementById('space-bg');
      if (spaceBg) {
        gsap.set(spaceBg, { opacity: surpriseVal });
        const sctx = spaceBg.getContext('2d');
        let sw, sh;

        function resizeSpace() {
          sw = window.innerWidth;
          sh = window.innerHeight;
          spaceBg.width = sw;
          spaceBg.height = sh;
        }
        resizeSpace();
        window.addEventListener('resize', resizeSpace);

        // Stars — fewer, brighter, more like real night sky
        const stars = [];
        for (let i = 0; i < 80; i++) {
          stars.push({
            x: Math.random() * sw,
            y: Math.random() * sh,
            r: Math.random() * 1.8 + 0.5,
            a: Math.random() * 0.6 + 0.4,
            speed: Math.random() * 0.003 + 0.001,
            phase: Math.random() * Math.PI * 2,
          });
        }

        // Nebula clouds — blue tones only
        const nebulaColors = [
          { r: 0, g: 210, b: 255 },   // electric cyan
          { r: 0, g: 170, b: 240 },   // bright cyan
          { r: 0, g: 140, b: 220 },   // sky blue
          { r: 30, g: 120, b: 200 },  // mid blue
          { r: 20, g: 80, b: 180 },   // royal blue
          { r: 15, g: 60, b: 140 },   // deep blue
          { r: 10, g: 35, b: 100 },   // dark blue
          { r: 5, g: 15, b: 50 },     // near black blue
        ];
        const clouds = [];
        for (let i = 0; i < 16; i++) {
          const col = nebulaColors[i % nebulaColors.length];
          clouds.push({
            x: Math.random() * sw,
            y: Math.random() * sh,
            rx: Math.random() * 450 + 200,
            ry: Math.random() * 300 + 150,
            r: col.r,
            g: col.g,
            b: col.b,
            a: Math.random() * 0.14 + 0.08,
            driftX: (Math.random() - 0.5) * 0.1,
            driftY: (Math.random() - 0.5) * 0.05,
          });
        }

        let t = 0;
        function drawSpace() {
          t += 0.016;
          sctx.fillStyle = '#000';
          sctx.fillRect(0, 0, sw, sh);

          // Draw nebula clouds
          clouds.forEach(c => {
            c.x += c.driftX;
            c.y += c.driftY;
            if (c.x > sw + c.rx) c.x = -c.rx;
            if (c.x < -c.rx) c.x = sw + c.rx;
            if (c.y > sh + c.ry) c.y = -c.ry;
            if (c.y < -c.ry) c.y = sh + c.ry;

            const grad = sctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, c.rx);
            grad.addColorStop(0, `rgba(${c.r},${c.g},${c.b},${c.a * 1.5})`);
            grad.addColorStop(0.4, `rgba(${c.r},${c.g},${c.b},${c.a})`);
            grad.addColorStop(1, 'rgba(0,0,0,0)');
            sctx.fillStyle = grad;
            sctx.beginPath();
            sctx.ellipse(c.x, c.y, c.rx, c.ry, 0, 0, Math.PI * 2);
            sctx.fill();
          });

          // Draw twinkling stars — soft glow, no hard pixels
          stars.forEach(s => {
            const twinkle = Math.sin(t * s.speed * 600 + s.phase) * 0.4 + 0.6;
            const alpha = s.a * twinkle;
            const glow = sctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.r * 5);
            glow.addColorStop(0, `rgba(255,255,255,${alpha})`);
            glow.addColorStop(0.3, `rgba(210,225,255,${alpha * 0.4})`);
            glow.addColorStop(1, 'rgba(0,0,0,0)');
            sctx.fillStyle = glow;
            sctx.beginPath();
            sctx.arc(s.x, s.y, s.r * 5, 0, Math.PI * 2);
            sctx.fill();
          });

          requestAnimationFrame(drawSpace);
        }
        drawSpace();
      }
    </script>
  </body>
</html>

<style>
  #hearts-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  .nav-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2.5rem;
    mix-blend-mode: difference;
  }

  .nav-logo {
    font-family: 'TurboDriver', 'TerminalGrotesque', sans-serif;
    font-size: 1.8rem;
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.05em;
    z-index: 102;
  }

  .nav-burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 102;
    flex-direction: column;
    gap: 5px;
  }

  .nav-burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .nav-burger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-burger.open span:nth-child(2) {
    opacity: 0;
  }

  .nav-burger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-links a {
    color: #fff;
    text-decoration: none;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    transition: opacity 0.3s ease;
  }

  .nav-links a:hover {
    opacity: 0.5;
    color: #fff;
  }

  .site-footer {
    padding: 3rem 2rem;
    text-align: center;
  }

  .site-footer span {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.7rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  @media (max-width: 600px) {
    .nav-overlay {
      padding: 0.8rem 1rem;
    }

    .nav-burger {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 3rem;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
      z-index: 101;
      mix-blend-mode: normal;
    }

    .nav-links.open {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-links a {
      font-size: 1.3rem;
      letter-spacing: 0.25em;
      padding: 0.5rem 1rem;
    }

    .site-footer {
      padding: 2rem 1rem;
    }

    .site-footer span {
      font-size: 0.6rem;
    }
  }
</style>
