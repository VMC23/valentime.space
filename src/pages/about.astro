---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="About — Valentine Brasser" description="Fragend schreite ich voran">
  <main class="about">
    <h1 class="quote">Fragend<br>schreite ich voran</h1>
    <p class="quote-source">"preguntando caminamos"<br>Zapatista de Liberación Nacional</p>

    <hr class="divider">

    <p class="bio">I move through spaces — listening, watching, filming, cleaning, speaking, teaching — where social practices are questioned and explored. Embracing the queer art of failure.</p>
    <p class="bio contact">cv or collab? say hi.<br>hoi@wokebit.ch</p>

    <p class="bio collab-label">ps. i collaborated with:</p>

    <div class="collab-space" id="collab-space">
      <div class="collab-field" id="collab-field">
        <span class="collab-name">ETH Plant Science Center</span>
        <span class="collab-name">Verweben ZHdK</span>
        <span class="collab-name">Recht auf Wir ZHdK</span>
        <span class="collab-name">Gessnerallee</span>
        <span class="collab-name">Fotogen Model Agency</span>
        <span class="collab-name">Schauspielhaus Zürich</span>
        <span class="collab-name">Schule Baden</span>
        <span class="collab-name">Goldbach Media</span>
        <span class="collab-name">Château Festival</span>
        <span class="collab-name">Photobastei</span>
        <span class="collab-name">Underground Raves</span>
        <span class="collab-name">Hedonistische Internationale</span>
        <span class="collab-name">Anna Papst</span>
        <span class="collab-name">Kathrin Veith</span>
        <span class="collab-name">Sophie Vögele</span>
        <span class="collab-name">Design for Democracy</span>
        <span class="collab-name">Musée Visionnaire</span>
      </div>
    </div>

    <p class="bio pps">pps. i coded this website with Claude and Astro.</p>

    <a href="/blog" class="blog-link">+blog</a>
  </main>
</Layout>

<script>
  import gsap from 'gsap';

  gsap.set('.about .quote', { opacity: 0, y: 30 });
  gsap.to('.about .quote', { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.3 });

  gsap.set('.about .quote-source', { opacity: 0 });
  gsap.to('.about .quote-source', { opacity: 0.6, duration: 1, ease: 'power2.out', delay: 0.8 });

  gsap.set('.about .divider', { scaleX: 0 });
  gsap.to('.about .divider', { scaleX: 1, duration: 0.8, ease: 'power2.inOut', delay: 1.0 });

  gsap.set('.about .bio', { opacity: 0, y: 20 });
  gsap.to('.about .bio', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 1.2, stagger: 0.15 });

  // Collaborator names — fixed positions inside the oval
  const names = document.querySelectorAll('.collab-name');
  const field = document.getElementById('collab-field');

  if (names.length && field) {
    const collabColors = [
      '#00d2ff', '#ff6b9d', '#a78bfa', '#34d399', '#fbbf24',
      '#f87171', '#818cf8', '#fb923c', '#2dd4bf', '#e879f9',
      '#38bdf8', '#a3e635', '#f472b6', '#67e8f9', '#c084fc',
      '#fcd34d', '#4ade80',
    ];

    // Make names visible so we can measure them
    names.forEach(n => { (n as HTMLElement).style.visibility = 'hidden'; (n as HTMLElement).style.opacity = '1'; });

    function placeNames() {
      const fw = field.offsetWidth;
      const fh = field.offsetHeight;
      const cx = fw / 2;
      const cy = fh / 2;
      const rx = cx * 0.85;
      const ry = cy * 0.85;
      const pad = 6;

      interface Placed { left: number; top: number; right: number; bottom: number; }
      const placed: Placed[] = [];

      function overlaps(l: number, t: number, w: number, h: number) {
        return placed.some(p =>
          l < p.right + pad && l + w + pad > p.left && t < p.bottom + pad && t + h + pad > p.top
        );
      }

      function isInEllipse(l: number, t: number, w: number, h: number) {
        const corners = [[l, t], [l + w, t], [l, t + h], [l + w, t + h]];
        return corners.every(([px, py]) => {
          const dx = (px - cx) / rx;
          const dy = (py - cy) / ry;
          return dx * dx + dy * dy <= 1;
        });
      }

      const nameEls = Array.from(names) as HTMLElement[];
      // Sort by width descending — place bigger names first
      const sorted = nameEls.map((el, i) => ({ el, i })).sort((a, b) => b.el.offsetWidth - a.el.offsetWidth);

      sorted.forEach(({ el, i }) => {
        const ew = el.offsetWidth;
        const eh = el.offsetHeight;
        let bestLeft = cx - ew / 2;
        let bestTop = cy - eh / 2;
        let found = false;

        for (let attempt = 0; attempt < 300; attempt++) {
          const angle = Math.random() * Math.PI * 2;
          const dist = Math.sqrt(Math.random());
          const left = cx + Math.cos(angle) * dist * rx - ew / 2;
          const top = cy + Math.sin(angle) * dist * ry - eh / 2;

          if (isInEllipse(left, top, ew, eh) && !overlaps(left, top, ew, eh)) {
            bestLeft = left;
            bestTop = top;
            found = true;
            break;
          }
        }

        placed.push({ left: bestLeft, top: bestTop, right: bestLeft + ew, bottom: bestTop + eh });

        const color = collabColors[i % collabColors.length];
        gsap.set(el, { left: bestLeft, top: bestTop, visibility: 'visible', opacity: 0, color });
        gsap.to(el, { opacity: 0.9, duration: 1.5, ease: 'power2.out', delay: 1.5 + i * 0.15 });
      });
    }

    // Place after fonts are loaded
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => placeNames());
    } else {
      window.addEventListener('load', placeNames);
    }
  }
</script>

<style>
  .about {
    max-width: 680px;
    margin: 0 auto;
    padding: 10rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: visible;
  }

  .quote {
    font-family: 'TurboDriver', 'TerminalGrotesque', sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    font-weight: normal;
    color: #fff;
    line-height: 1.3;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }

  .quote-source {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.8rem, 2.5vw, 1.05rem);
    color: #ddd;
    font-style: italic;
    line-height: 1.6;
    letter-spacing: 0.05em;
  }

  .divider {
    border: none;
    height: 1px;
    background: #333;
    width: 60px;
    margin: 3rem 0;
    transform-origin: center;
    transform: scaleX(0);
  }

  .bio {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    color: #eee;
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 1rem;
  }

  .contact {
    margin-top: 1rem;
    color: #00d2ff;
  }


  .collab-space {
    width: 100%;
    margin-top: 1.5rem;
    padding: 1rem 0;
    font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    display: flex;
    justify-content: center;
  }

  .collab-label {
    margin-top: 2rem;
    color: #aaa;
  }

  .pps {
    margin-top: 2rem;
    color: #00d2ff;
  }

  .blog-link {
    margin-top: 2rem;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.85rem;
    color: #00d2ff;
    text-decoration: none;
    letter-spacing: 0.15em;
    transition: opacity 0.3s ease;
  }

  .blog-link:hover {
    opacity: 0.5;
  }

  .collab-field {
    position: relative;
    width: min(98vw, 1000px);
    height: 45vh;
    min-height: 350px;
    border: none;
    border-radius: 50%;
    margin: 0 auto;
    overflow: hidden;
  }

  .collab-name {
    position: absolute;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: inherit;
    color: #eee;
    white-space: nowrap;
    opacity: 0;
  }


  @media (max-width: 768px) {
    .about {
      padding: 6rem 1.5rem 2rem;
    }
    .divider {
      margin: 2.5rem 0;
    }
    .collab-field {
      width: 95vw;
      height: 55vh;
      min-height: 400px;
    }
    .collab-name {
      white-space: nowrap;
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .about {
      padding: 5rem 1.2rem 1rem;
    }
    .divider {
      margin: 2rem 0;
    }
    .bio {
      line-height: 1.7;
    }
    .contact {
      font-size: 0.85rem;
    }
    .collab-space {
      margin-top: 3rem;
    }
    .collab-field {
      width: 95vw;
      height: 70vh;
      min-height: 450px;
    }
  }
</style>
