---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="About — Valentine Brasser" description="Fragend schreite ich voran">
  <main class="about">
    <h1 class="quote">Fragend<br>schreite ich voran</h1>
    <p class="quote-source">"preguntando caminamos"<br>Zapatista de Liberación Nacional</p>

    <hr class="divider">

    <p class="bio">I move through spaces — listening, watching, filming, cleaning, speaking, teaching — where social practices are questioned and explored. Embracing the queer art of failure.</p>
    <div class="cv-frame">
      <p class="frame-heading">cv or collab? say hi.</p>
      <p class="frame-email">hoi@wokebit.ch</p>

      <hr class="frame-divider">

      <div class="collab-grid">
        <div class="collab-group">
          <h3 class="collab-category">Institutions & Education</h3>
          <ul class="collab-list">
            <li>ETH Plant Science Center</li>
            <li>Verweben, ZHdK</li>
            <li>Recht auf Wir, ZHdK</li>
            <li>Design for Democracy, Frankfurt</li>
            <li>Bezirksschule Baden</li>
          </ul>
        </div>

        <div class="collab-group">
          <h3 class="collab-category">Venues & Culture</h3>
          <ul class="collab-list">
            <li>Schauspielhaus Zürich</li>
            <li>Gessnerallee</li>
            <li>Photobastei</li>
            <li>Musée Visionnaire</li>
          </ul>
        </div>

        <div class="collab-group">
          <h3 class="collab-category">Festivals & Nightlife</h3>
          <ul class="collab-list">
            <li>Château Festival</li>
            <li>Hedonistische Internationale</li>
            <li>Underground Raves</li>
          </ul>
        </div>

        <div class="collab-group">
          <h3 class="collab-category">Media & Industry</h3>
          <ul class="collab-list">
            <li>Fotogen Model Agency</li>
            <li>Goldbach Media</li>
          </ul>
        </div>

        <div class="collab-group">
          <h3 class="collab-category">People</h3>
          <ul class="collab-list">
            <li>Anna Papst</li>
            <li>Kathrin Veith</li>
            <li>Sophie Vögele</li>
          </ul>
        </div>
      </div>
    </div>

    <a href="/blog" class="blog-link">+blog</a>
  </main>
</Layout>

<script>
  import gsap from 'gsap';

  gsap.set('.about .quote', { opacity: 0, y: 30 });
  gsap.to('.about .quote', { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.3 });

  gsap.set('.about .quote-source', { opacity: 0 });
  gsap.to('.about .quote-source', { opacity: 0.6, duration: 1, ease: 'power2.out', delay: 0.8 });

  gsap.set('.about .divider', { scaleX: 0 });
  gsap.to('.about .divider', { scaleX: 1, duration: 0.8, ease: 'power2.inOut', delay: 1.0 });

  gsap.set('.about .bio', { opacity: 0, y: 20 });
  gsap.to('.about .bio', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 1.2, stagger: 0.15 });

  gsap.set('.cv-frame', { opacity: 0, y: 30 });
  gsap.to('.cv-frame', { opacity: 1, y: 0, duration: 1, ease: 'power2.out', delay: 1.6 });

  gsap.set('.collab-group', { opacity: 0, y: 15 });
  gsap.to('.collab-group', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 2, stagger: 0.12 });
</script>

<style>
  .about {
    max-width: 680px;
    margin: 0 auto;
    padding: 10rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: visible;
  }

  .quote {
    font-family: 'TurboDriver', 'TerminalGrotesque', sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    font-weight: normal;
    color: #fff;
    line-height: 1.3;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }

  .quote-source {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.8rem, 2.5vw, 1.05rem);
    color: #ddd;
    font-style: italic;
    line-height: 1.6;
    letter-spacing: 0.05em;
  }

  .divider {
    border: none;
    height: 1px;
    background: #333;
    width: 60px;
    margin: 3rem 0;
    transform-origin: center;
    transform: scaleX(0);
  }

  .bio {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    color: #eee;
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 1rem;
  }

  .cv-frame {
    width: 100%;
    max-width: 600px;
    margin-top: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 2.5rem 2rem;
  }

  .frame-heading {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.95rem, 2.5vw, 1.15rem);
    color: #fff;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .frame-email {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.85rem, 2vw, 1rem);
    color: #00d2ff;
    letter-spacing: 0.05em;
  }

  .frame-divider {
    border: none;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin: 2rem 0;
  }

  .collab-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.8rem 2.5rem;
    text-align: left;
  }

  .collab-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .collab-category {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 0.3rem;
    font-weight: normal;
  }

  .collab-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .collab-list li {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.75rem, 2vw, 0.85rem);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
  }

  .pps {
    margin-top: 2rem;
    color: #00d2ff;
  }

  .blog-link {
    margin-top: 2rem;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.85rem;
    color: #00d2ff;
    text-decoration: none;
    letter-spacing: 0.15em;
    transition: opacity 0.3s ease;
  }

  .blog-link:hover {
    opacity: 0.5;
  }

  .collab-field {
    position: relative;
    width: min(98vw, 1000px);
    height: 45vh;
    min-height: 350px;
    border: none;
    border-radius: 50%;
    margin: 0 auto;
    overflow: hidden;
  }

  .collab-name {
    position: absolute;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: inherit;
    color: #eee;
    white-space: nowrap;
    opacity: 0;
  }


  @media (max-width: 768px) {
    .about {
      padding: 6rem 1.5rem 2rem;
    }
    .divider {
      margin: 2.5rem 0;
    }
  }

  @media (max-width: 480px) {
    .about {
      padding: 5rem 1.2rem 1rem;
    }
    .divider {
      margin: 2rem 0;
    }
    .bio {
      line-height: 1.7;
    }
    .cv-frame {
      padding: 1.8rem 1.2rem;
      margin-top: 2rem;
    }
    .collab-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
