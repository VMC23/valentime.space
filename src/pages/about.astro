---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="About — Valentine Brasser" description="Fragend schreite ich voran">
  <main class="about">
    <h1 class="quote">Fragend<br>schreite ich voran</h1>
    <p class="quote-source">"preguntando caminamos"<br>Zapatista de Liberación Nacional</p>

    <hr class="divider">

    <p class="bio">I move through spaces — listening, watching, filming, cleaning, speaking, teaching — where social practices are questioned and explored. Embracing the queer art of failure.</p>
    <div class="contact-block">
      <p class="frame-heading">cv or collab? say hi.</p>
      <p class="frame-email" id="copy-email" data-email="valentime@tutamail.com">valentime@tutamail.com</p>
    </div>

    <a href="/blog" class="blog-link">+blog</a>
  </main>

  <div class="collab-marquee">
    <div class="collab-marquee-inner">
      <span class="collab-marquee-text">ETH &nbsp;·&nbsp; ZHdK &nbsp;·&nbsp; Schauspielhaus Zürich &nbsp;·&nbsp; Documenta fifteen &nbsp;·&nbsp; Gessnerallee &nbsp;·&nbsp; Photobastei &nbsp;·&nbsp; Musée Visionnaire &nbsp;·&nbsp; Château Festival &nbsp;·&nbsp; Design for Democracy &nbsp;·&nbsp; Hedonistische Internationale &nbsp;·&nbsp; Bezirksschule Baden &nbsp;·&nbsp;&nbsp;&nbsp;&nbsp;</span>
      <span class="collab-marquee-text">ETH &nbsp;·&nbsp; ZHdK &nbsp;·&nbsp; Schauspielhaus Zürich &nbsp;·&nbsp; Documenta fifteen &nbsp;·&nbsp; Gessnerallee &nbsp;·&nbsp; Photobastei &nbsp;·&nbsp; Musée Visionnaire &nbsp;·&nbsp; Château Festival &nbsp;·&nbsp; Design for Democracy &nbsp;·&nbsp; Hedonistische Internationale &nbsp;·&nbsp; Bezirksschule Baden &nbsp;·&nbsp;&nbsp;&nbsp;&nbsp;</span>
    </div>
  </div>
</Layout>

<script>
  import gsap from 'gsap';

  gsap.set('.about .quote', { opacity: 0, y: 30 });
  gsap.to('.about .quote', { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.3 });

  gsap.set('.about .quote-source', { opacity: 0 });
  gsap.to('.about .quote-source', { opacity: 0.6, duration: 1, ease: 'power2.out', delay: 0.8 });

  gsap.set('.about .divider', { scaleX: 0 });
  gsap.to('.about .divider', { scaleX: 1, duration: 0.8, ease: 'power2.inOut', delay: 1.0 });

  gsap.set('.about .bio', { opacity: 0, y: 20 });
  gsap.to('.about .bio', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 1.2, stagger: 0.15 });

  gsap.set('.contact-block', { opacity: 0, y: 30 });
  gsap.to('.contact-block', { opacity: 1, y: 0, duration: 1, ease: 'power2.out', delay: 1.6 });

  gsap.set('.collab-marquee', { opacity: 0 });
  gsap.to('.collab-marquee', { opacity: 1, duration: 1, ease: 'power2.out', delay: 2 });

  const copyEl = document.getElementById('copy-email');
  if (copyEl) {
    copyEl.addEventListener('click', () => {
      navigator.clipboard.writeText(copyEl.dataset.email);
      copyEl.textContent = 'copied!';
      setTimeout(() => { copyEl.textContent = copyEl.dataset.email; }, 1500);
    });
  }
</script>

<style>
  .about {
    max-width: 680px;
    margin: 0 auto;
    padding: 10rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: visible;
  }

  .quote {
    font-family: 'TurboDriver', 'TerminalGrotesque', sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    font-weight: normal;
    color: #fff;
    line-height: 1.3;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }

  .quote-source {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.8rem, 2.5vw, 1.05rem);
    color: #ddd;
    font-style: italic;
    line-height: 1.6;
    letter-spacing: 0.05em;
  }

  .divider {
    border: none;
    height: 1px;
    background: #333;
    width: 60px;
    margin: 3rem 0;
    transform-origin: center;
    transform: scaleX(0);
  }

  .bio {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    color: #eee;
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 1rem;
  }

  .contact-block {
    margin-top: 3rem;
  }

  .frame-heading {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.95rem, 2.5vw, 1.15rem);
    color: #fff;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .frame-email {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.85rem, 2vw, 1rem);
    color: #00d2ff;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .frame-email:hover {
    opacity: 0.6;
  }

  .collab-marquee {
    width: 100%;
    overflow: hidden;
    padding: 3rem 0 2rem;
  }

  .collab-marquee-inner {
    display: flex;
    width: max-content;
    animation: collab-scroll 35s linear infinite;
  }

  .collab-marquee-text {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.65rem, 1.5vw, 0.8rem);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @keyframes collab-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .blog-link {
    margin-top: 2rem;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.85rem;
    color: #00d2ff;
    text-decoration: none;
    letter-spacing: 0.15em;
    transition: opacity 0.3s ease;
  }

  .blog-link:hover {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .about {
      padding: 6rem 1.5rem 2rem;
    }
    .divider {
      margin: 2.5rem 0;
    }
  }

  @media (max-width: 480px) {
    .about {
      padding: 5rem 1.2rem 1rem;
    }
    .divider {
      margin: 2rem 0;
    }
    .bio {
      line-height: 1.7;
    }
    .contact-block {
      margin-top: 2rem;
    }
    .collab-marquee-inner {
      animation-duration: 18s;
    }
  }
</style>
