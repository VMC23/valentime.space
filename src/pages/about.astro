---
import Layout from '../layouts/MainLayout.astro';
---

<Layout title="About — Valentine Brasser" description="Fragend schreite ich voran">
  <main class="about">
    <h1 class="quote">Fragend schreite ich voran</h1>
    <p class="quote-source">"preguntando caminamos"<br>Zapatista de Liberación Nacional</p>

    <hr class="divider">

    <p class="bio">an den Rändern von Institutionen, in der freien Szene zwischen Altstetten und Bröllin.</p>
    <p class="bio">Resistance, Care und Vernetzung an sich ist bereits ein Vollzeitjob. Daneben liebe ich es, mit Jugendlichen zu gestalten — und Videomaterial zu generieren.</p>
    <p class="bio contact">CV? &rarr; auf Anfrage.</p>
  </main>
</Layout>

<script>
  import gsap from 'gsap';

  gsap.fromTo('.about .quote',
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.3 }
  );
  gsap.fromTo('.about .quote-source',
    { opacity: 0 },
    { opacity: 0.6, duration: 1, ease: 'power2.out', delay: 0.8 }
  );
  gsap.fromTo('.about .divider',
    { scaleX: 0 },
    { scaleX: 1, duration: 0.8, ease: 'power2.inOut', delay: 1.0 }
  );
  gsap.fromTo('.about .bio',
    { opacity: 0, y: 20 },
    { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 1.2, stagger: 0.15 }
  );
</script>

<style>
  .about {
    max-width: 680px;
    margin: 0 auto;
    padding: 10rem 2rem 6rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .quote {
    font-family: 'TurboDriver', 'TerminalGrotesque', sans-serif;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    font-weight: normal;
    color: #fff;
    line-height: 1.1;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    opacity: 0;
  }

  .quote-source {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.85rem;
    color: #888;
    font-style: italic;
    line-height: 1.6;
    letter-spacing: 0.05em;
    opacity: 0;
  }

  .divider {
    border: none;
    height: 1px;
    background: #333;
    width: 60px;
    margin: 3rem 0;
    transform-origin: center;
    transform: scaleX(0);
  }

  .bio {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(0.95rem, 2.5vw, 1.1rem);
    color: #aaa;
    line-height: 1.8;
    max-width: 520px;
    margin-bottom: 1rem;
    opacity: 0;
  }

  .contact {
    margin-top: 1rem;
    color: #00d2ff;
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .about {
      padding: 8rem 1.5rem 4rem;
    }
  }
</style>
