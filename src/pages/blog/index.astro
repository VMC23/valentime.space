---
import Layout from '../../layouts/MainLayout.astro';
import { readFileSync } from 'fs';
import { glob } from 'glob';
import { join } from 'path';
import frontMatter from 'front-matter';
import { marked } from 'marked';

const blogDir = join(import.meta.dirname, '../../../blog/entries');
const mdFiles = glob.sync(join(blogDir, '*.md'));

const posts = mdFiles.map(file => {
  const content = readFileSync(file, 'utf-8');
  const fm = frontMatter(content);
  const slug = file.split('/').pop()?.replace('.md', '');
  return {
    slug,
    ...fm.attributes,
    html: marked(fm.body),
  };
}).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="Blog" description="My Astro + Vue blog">
  <main class="container">
    <h1>Blog Posts</h1>

    <section class="posts">
      {posts.map(post => {
        const truncate = post.slug !== 'essay-als-kunstform';
        return (
          <article class="post">
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p class="meta">{new Date(post.date).toLocaleDateString()}</p>
            <div class={`content ${truncate ? 'content--truncated' : ''}`} set:html={post.html} />
            {truncate && (
              <a href={`/blog/${post.slug}`} class="read-more">weiterlesen &rarr;</a>
            )}
          </article>
        );
      })}
    </section>

    <div class="cta-link">
      <a href="/" class="home-link">+work</a>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(4rem, 8vh, 6rem) clamp(1rem, 4vw, 2rem) 2rem;
  }

  h1 {
    text-align: center;
    color: #e0e0e0;
    margin-bottom: 2rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .post {
    padding-bottom: 2rem;
    border-bottom: 1px solid #333;
  }

  .post:last-child {
    border-bottom: none;
  }

  h2 {
    margin: 0 0 0.5rem;
    color: #ffffff;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }

  h2 a {
    color: #fff;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  h2 a:hover {
    color: #00d2ff;
  }

  .content--truncated {
    max-height: 7.5em;
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
  }

  .read-more {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.85rem;
    color: #00d2ff;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: opacity 0.3s ease;
  }

  .read-more:hover {
    opacity: 0.6;
  }

  .meta {
    color: #aaa;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .content :global(p) {
    color: #ccc;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .content :global(blockquote) {
    border-left: 2px solid #333;
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
  }

  .content :global(blockquote p) {
    color: #999;
    font-style: italic;
  }

  .content :global(.blog-video) {
    max-width: 100%;
    width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem 0;
  }

  .content :global(.video-caption) {
    color: #666;
    font-size: 0.8rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .cta-link {
    text-align: center;
    padding: 3rem 0 2rem;
  }

  .home-link {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.85rem;
    color: #00d2ff;
    text-decoration: none;
    letter-spacing: 0.15em;
    transition: opacity 0.3s ease;
  }

  .home-link:hover {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .posts {
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: clamp(4rem, 8vh, 5rem) 1rem 1.5rem;
    }
    h2 {
      font-size: clamp(1.1rem, 5vw, 1.4rem);
    }
    .meta {
      font-size: 0.8rem;
    }
    .read-more {
      font-size: 0.8rem;
      padding: 0.3rem 0;
    }
    .content :global(p) {
      font-size: 0.9rem;
      line-height: 1.7;
    }
  }
</style>
