---
import Layout from '../layouts/MainLayout.astro';

const title = "Valentine Brasser — Multimedia Artist & Educator";
const description = "Valentine Brasser / Valentin:e Brasser — Multimedia Artist & Educator. Video Art, Vermittlung, Performance. Portfolio mit Arbeiten aus Zürich, Berlin, Frankfurt und documenta.";
---

<Layout title={title} description={description}>

  <!-- HERO: glitch title + video below -->
  <section class="hero">
    <div class="hero-content" id="hero-title">
      <canvas id="hero-glitch-canvas"></canvas>
      <div class="vibe-slider-wrap">
        <p class="vibe-question">how are you today?</p>
        <input type="range" id="vibe-slider" min="0" max="100" value="0" class="vibe-slider" />
        <div class="vibe-slider-labels">
          <span class="vibe-label">black is my favourite color</span>
          <span class="vibe-label vibe-label-right">seeking for some cuteness</span>
        </div>
      </div>
    </div>
    <div class="hero-video-below">
      <div class="flip-card flip-card-hero">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <video src="/ResistanceIsKey.mp4" autoplay loop muted playsinline class="hero-video"></video>
            <p class="hero-caption hero-caption-bright" id="hero-caption">Resistance Is Key — Zurich, 2026</p>
          </div>
          <div class="flip-card-back flip-card-back-hero">
            <p>By now I have accumulated a vast amount of video material from places that inspire me. Often static, 60 sec each.<br><span class="flip-back-meta">Zurich, 2026.</span></p>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-heart-wrap">
      <canvas id="heart-glitch-canvas"></canvas>
    </div>
  </section>

  <!-- PROJECT: Diversity Cinema -->
  <section class="project-section" data-anim>
    <div class="project-full">
      <div class="flip-card">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <video src="/gender_Diversity Cinema.mp4" autoplay loop muted playsinline class="project-video"></video>
          </div>
          <div class="flip-card-back">
            <p>Diversity Cinema «Wie wir die Welt berühren...»<br><span class="flip-back-meta">Kino Toni, 2026.</span><br><span class="flip-back-note">* This film (4') about the nervous system is part of my ongoing<br>research for a new theatre project, with Anna Papst.</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECT: Decolonial -->
  <section class="project-section" data-anim>
    <div class="project-full">
      <div class="flip-card">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <video src="/Decolonial Website Vid.mov" autoplay loop muted playsinline class="project-video"></video>
          </div>
          <div class="flip-card-back">
            <p>Performance on whiteness, Diversity Politics and the Arts: Post-colonial Perspectives<br><span class="flip-back-meta">ZHdK, 2026.</span><br><span class="flip-back-note">* I performed a piece about whiteness in my final minor of the<br>Master Critical Social Practice at ZHdK.<br>PS: The course video also features some of my video work — <a href="https://youtu.be/yPkTUs8QsM8?si=N6rI8Ovv-YAXRmGH" target="_blank" rel="noopener" class="flip-back-link" onclick="event.stopPropagation()">have a look &rarr;</a></span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY ARE YOU HERE? -->
  <section class="why-here-section" data-anim>
    <div class="why-here-wrap">
      <p class="why-here-question" id="why-here-q">Why are you here on my page?</p>
      <div class="why-here-buttons" id="why-here-buttons">
        <button class="why-btn" data-reply="Good luck!">I want to spy on you</button>
        <button class="why-btn" data-reply="Great — keep scrolling, there's plenty of good reasons.">I'm considering whether to give you funding</button>
        <button class="why-btn" data-reply="That's sweet ♡">I think you're cute</button>
        <button class="why-btn" data-reply="Same. At least you're doing it with taste.">I'm procrastinating</button>
        <button class="why-btn" data-reply="I want to collaborate → <a href='/about'>let's talk</a>">I want to collaborate</button>
        <button class="why-btn" data-reply="Tell them I said hi.">My professor sent me here</button>
        <button class="why-btn" data-reply="Hello my friend ♡">I'm your friend &lt;3</button>
      </div>
      <p class="why-here-reply" id="why-here-reply"></p>
    </div>
  </section>

  <!-- PROJECT: Moods -->
  <section class="project-section" data-anim>
    <div class="project-full">
      <div class="flip-card">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <video src="/Moods_Video.mp4" autoplay loop muted playsinline class="project-video"></video>
          </div>
          <div class="flip-card-back">
            <p>Ali Dada, Concert<br><span class="flip-back-meta">Moods, 2025.</span><br><span class="flip-back-note">* My dear friends played a beautiful gig and I filmed it — using real<br>crystals in front of the lens for the psychedelic effects.</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECT: ALL IN -->
  <section class="project-section" data-anim>
    <div class="project-full">
      <div class="flip-card">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <video src="/ALLIN_clip.mp4" autoplay loop muted playsinline class="project-video"></video>
          </div>
          <div class="flip-card-back">
            <p>ALL IN — Elon Liberman<br><span class="flip-back-meta">Musée Visionnaire, 2025.</span><br><span class="flip-back-note">* Happy to have filmed such a playful sound machine and artist.<br>Video for an installation at the Musée Visionnaire.</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GLITCH: GitHub -->
  <section class="project-section glitch-section" data-anim>
    <div class="glitch-wrap">
      <div class="flip-card flip-card-glitch">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <canvas id="github-glitch-canvas"></canvas>
          </div>
          <div class="flip-card-back">
            <div class="flip-back-content">
              <p>yes, this site is handmade</p>
              <a href="https://github.com/VMC23" target="_blank" rel="noopener" class="glitch-link" onclick="event.stopPropagation()">github &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECT: Blob Berlin -->
  <section class="project-section" data-anim>
    <div class="project-full">
      <div class="flip-card">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <video src="/Blob Berlin Video.mp4" autoplay loop muted playsinline class="project-video"></video>
          </div>
          <div class="flip-card-back">
            <p>Blob, documenta fifteen<br><span class="flip-back-meta">Berlin, 2023.</span><br><span class="flip-back-note">* Grateful to be part of Kollektiv Loom Loop, which has grown into<br>a beautiful familial friendship. The final carpet was filmed in Berlin,<br>one year after its completion — <a href="https://loomloop.de/" target="_blank" rel="noopener" class="flip-back-link" onclick="event.stopPropagation()">check it out &rarr;</a></span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GLITCH: DJ -->
  <section class="project-section glitch-section" data-anim>
    <div class="glitch-wrap">
      <div class="flip-card flip-card-glitch">
        <div class="flip-card-inner">
          <div class="flip-card-front">
            <canvas id="glitch-canvas"></canvas>
          </div>
          <div class="flip-card-back">
            <div class="flip-back-content">
              <p>rave as an act of resistance</p>
              <a href="https://soundcloud.com/kracy-caro-valentines" target="_blank" rel="noopener" class="glitch-link" onclick="event.stopPropagation()">soundcloud &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ps-section" data-anim>
    <div class="ps-marquee">
      <div class="ps-marquee-inner">
        <span class="ps-marquee-text">PS: Switch to decentralised systems and take good care of your beautiful networks! It's going to be messy and adventurous.&nbsp;&nbsp;&nbsp;—&nbsp;&nbsp;&nbsp;</span>
        <span class="ps-marquee-text">PS: Switch to decentralised systems and take good care of your beautiful networks! It's going to be messy and adventurous.&nbsp;&nbsp;&nbsp;—&nbsp;&nbsp;&nbsp;</span>
      </div>
    </div>
  </section>

  <section class="about-cta" data-anim>
    <a href="/about" class="about-link">+about</a>
  </section>

</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Flip cards — click to toggle video/text
  document.querySelectorAll('.flip-card').forEach(card => {
    card.addEventListener('click', () => {
      card.classList.toggle('flipped');
    });
  });

  // Hero title fade in
  gsap.set('#hero-title', { opacity: 0 });
  gsap.to('#hero-title', { opacity: 1, duration: 1.2, delay: 0.4 });
  gsap.set('#hero-caption', { opacity: 0 });
  gsap.to('#hero-caption', { opacity: 0.85, duration: 1, ease: 'power2.out', delay: 1.4 });

  // Vibe slider — saves to localStorage, layout reads it
  const vibeSlider = document.getElementById('vibe-slider') as HTMLInputElement;
  const savedVibe = localStorage.getItem('vibeValue');

  if (vibeSlider) {
    // Restore saved value
    if (savedVibe) {
      vibeSlider.value = savedVibe;
      vibeSlider.dispatchEvent(new Event('input'));
    }

    const vibeQuestion = document.querySelector('.vibe-question') as HTMLElement;

    vibeSlider.addEventListener('input', () => {
      const val = parseInt(vibeSlider.value) / 100;
      // Save to localStorage so other pages pick it up
      localStorage.setItem('vibeValue', vibeSlider.value);
      // Dispatch custom event for layout to pick up
      window.dispatchEvent(new CustomEvent('vibeChange', { detail: { value: val } }));
      // Question, labels, and slider border turn blue from midpoint
      const blueMix = val <= 0.5 ? 0 : (val - 0.5) / 0.5;
      const r = Math.round(255 - (255 - 91) * blueMix);
      const g = Math.round(255 - (255 - 206) * blueMix);
      const b = Math.round(255 - (255 - 250) * blueMix);
      const a = 0.45 + blueMix * 0.55;
      const color = `rgba(${r}, ${g}, ${b}, ${a})`;

      if (vibeQuestion) vibeQuestion.style.color = color;
      vibeSlider.style.borderColor = color;
      document.querySelectorAll('.vibe-label').forEach(el => {
        (el as HTMLElement).style.color = color;
      });
    });
  }

  // Hero glitch canvas — same style as DJ glitch
  const hgc = document.getElementById('hero-glitch-canvas');
  if (hgc) {
    const hctx = hgc.getContext('2d');
    let hW, hH;
    function getHeroLines() {
      return hW < 480 ? ['Multimedia', 'Artist', '& Educator'] : ['Multimedia Artist', '& Educator'];
    }

    function resizeHeroCanvas() {
      hW = hgc.parentElement.offsetWidth;
      const lines = getHeroLines();
      hH = hW < 480 ? Math.min(hW * 0.55, 240) : Math.min(hW * 0.3, 280);
      hgc.width = hW;
      hgc.height = hH;
    }
    resizeHeroCanvas();
    window.addEventListener('resize', resizeHeroCanvas);

    const hFont = new FontFace('TurboDriver', "url('/fonts/turbo-driver/Turbo Driver Italic.otf')");
    hFont.load().then(f => {
      document.fonts.add(f);
      function drawHero() {
        hctx.clearRect(0, 0, hW, hH);

        const heroLines = getHeroLines();
        const fs = hW < 480 ? Math.min(hW * 0.1, 48) : Math.min(hW * 0.055, 72);
        hctx.font = `italic ${fs}px TurboDriver`;
        hctx.textAlign = 'center';
        hctx.textBaseline = 'middle';

        const ox = Math.random() > 0.88 ? (Math.random()-0.5) * 14 : 0;
        const oy = Math.random() > 0.88 ? (Math.random()-0.5) * 8 : 0;

        const gap = fs * 1.3;
        const totalHeight = (heroLines.length - 1) * gap;
        const startY = hH/2 - totalHeight / 2;

        // White base text
        heroLines.forEach((line, i) => {
          const ly = startY + i * gap;
          hctx.fillStyle = 'rgba(255,255,255,0.9)';
          hctx.fillText(line, hW/2, ly);
        });

        // RGB glitch layers
        hctx.globalCompositeOperation = 'lighter';
        heroLines.forEach((line, i) => {
          const ly = startY + i * gap + oy;
          hctx.fillStyle = 'rgba(255,0,0,0.3)';
          hctx.fillText(line, hW/2 - 3 + ox, ly);
          hctx.fillStyle = 'rgba(0,255,0,0.15)';
          hctx.fillText(line, hW/2 + ox, ly);
          hctx.fillStyle = 'rgba(0,100,255,0.3)';
          hctx.fillText(line, hW/2 + 3 + ox, ly);
        });
        hctx.globalCompositeOperation = 'source-over';

        // Glitch slices
        if (Math.random() > 0.7) {
          for (let i = 0; i < 3; i++) {
            const sy = Math.random() * hH;
            const sh = Math.random() * 25 + 5;
            const shift = (Math.random()-0.5) * 40;
            try {
              const slice = hctx.getImageData(0, sy, hW, sh);
              hctx.putImageData(slice, shift, sy);
            } catch(e) {}
          }
        }


        requestAnimationFrame(drawHero);
      }
      drawHero();
    });
  }

  // Animate each project section
  document.querySelectorAll('[data-anim]').forEach((section) => {
    gsap.set(section, { opacity: 0, y: 60 });
    gsap.to(section,
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 90%',
          end: 'top 40%',
          toggleActions: 'play none none none',
        }
      }
    );

    // Slight scale on videos inside
    const video = section.querySelector('video');
    if (video) {
      gsap.fromTo(video,
        { scale: 1.04 },
        {
          scale: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: video,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          }
        }
      );
    }
  });

  // GitHub glitch canvas
  const ghc = document.getElementById('github-glitch-canvas');
  if (ghc) {
    const ghctx = ghc.getContext('2d');
    function getGhLines() {
      return ghW < 500 ? ['check out', 'my github &', 'show me yours!'] : ['check out my github', '& show me yours!'];
    }
    let ghW, ghH;

    function resizeGhCanvas() {
      ghW = ghc.parentElement.offsetWidth;
      ghH = ghW < 480 ? Math.min(ghW * 0.55, 300) : Math.min(ghW * 0.45, 500);
      ghc.width = ghW;
      ghc.height = ghH;
    }
    resizeGhCanvas();
    window.addEventListener('resize', resizeGhCanvas);

    const ghFont = new FontFace('TurboDriver', "url('/fonts/turbo-driver/Turbo Driver Italic.otf')");
    ghFont.load().then(f => {
      document.fonts.add(f);
      function drawGh() {
        ghctx.clearRect(0, 0, ghW, ghH);

        const ghLines = getGhLines();
        const fs = ghW < 500 ? Math.min(ghW * 0.065, 32) : Math.min(ghW * 0.055, 72);
        ghctx.font = `italic ${fs}px TurboDriver`;
        ghctx.textAlign = 'center';
        ghctx.textBaseline = 'middle';

        const ox = Math.random() > 0.88 ? (Math.random()-0.5) * 14 : 0;
        const oy = Math.random() > 0.88 ? (Math.random()-0.5) * 8 : 0;

        ghctx.globalCompositeOperation = 'lighter';
        const gap = fs * 1.4;
        const totalHeight = (ghLines.length - 1) * gap;
        const startY = ghH/2 - totalHeight / 2;
        ghLines.forEach((line, i) => {
          const ly = startY + i * gap + oy;
          ghctx.fillStyle = 'rgba(255,0,0,0.7)';
          ghctx.fillText(line, ghW/2 - 3 + ox, ly);
          ghctx.fillStyle = 'rgba(0,255,0,0.7)';
          ghctx.fillText(line, ghW/2 + ox, ly);
          ghctx.fillStyle = 'rgba(0,100,255,0.7)';
          ghctx.fillText(line, ghW/2 + 3 + ox, ly);
        });
        ghctx.globalCompositeOperation = 'source-over';

        if (Math.random() > 0.7) {
          for (let i = 0; i < 3; i++) {
            const sy = Math.random() * ghH;
            const sh = Math.random() * 25 + 5;
            const shift = (Math.random()-0.5) * 40;
            try {
              const slice = ghctx.getImageData(0, sy, ghW, sh);
              ghctx.putImageData(slice, shift, sy);
            } catch(e) {}
          }
        }

        requestAnimationFrame(drawGh);
      }
      drawGh();
    });
  }

  // Glitch canvas
  const gc = document.getElementById('glitch-canvas');
  if (gc) {
    const ctx = gc.getContext('2d');
    function getDjLines() {
      return W < 500 ? ['&', 'sometimes', 'i love to dj'] : ['&', 'sometimes i love to dj'];
    }
    let W, H;

    function resizeCanvas() {
      W = gc.parentElement.offsetWidth;
      H = W < 480 ? Math.min(W * 0.55, 300) : Math.min(W * 0.45, 500);
      gc.width = W;
      gc.height = H;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    const font = new FontFace('TurboDriver', "url('/fonts/turbo-driver/Turbo Driver Italic.otf')");
    font.load().then(f => {
      document.fonts.add(f);
      function draw() {
        ctx.clearRect(0, 0, W, H);

        const lines = getDjLines();
        const fs = W < 500 ? Math.min(W * 0.065, 32) : Math.min(W * 0.055, 72);
        ctx.font = `italic ${fs}px TurboDriver`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        const ox = Math.random() > 0.88 ? (Math.random()-0.5) * 14 : 0;
        const oy = Math.random() > 0.88 ? (Math.random()-0.5) * 8 : 0;

        ctx.globalCompositeOperation = 'lighter';
        const gap = fs * 1.4;
        const totalHeight = (lines.length - 1) * gap;
        const startY = H/2 - totalHeight / 2;
        lines.forEach((line, i) => {
          const ly = startY + i * gap + oy;
          ctx.fillStyle = 'rgba(255,0,0,0.7)';
          ctx.fillText(line, W/2 - 3 + ox, ly);
          ctx.fillStyle = 'rgba(0,255,0,0.7)';
          ctx.fillText(line, W/2 + ox, ly);
          ctx.fillStyle = 'rgba(0,100,255,0.7)';
          ctx.fillText(line, W/2 + 3 + ox, ly);
        });
        ctx.globalCompositeOperation = 'source-over';

        // Glitch slices
        if (Math.random() > 0.7) {
          for (let i = 0; i < 3; i++) {
            const sy = Math.random() * H;
            const sh = Math.random() * 25 + 5;
            const shift = (Math.random()-0.5) * 40;
            try {
              const slice = ctx.getImageData(0, sy, W, sh);
              ctx.putImageData(slice, shift, sy);
            } catch(e) {}
          }
        }


        requestAnimationFrame(draw);
      }
      draw();
    });
  }

  // Heart glitch canvas
  const heartCanvas = document.getElementById('heart-glitch-canvas');
  if (heartCanvas) {
    const hrt = heartCanvas.getContext('2d');
    let hw, hh;

    function resizeHeart() {
      hw = heartCanvas.parentElement.offsetWidth;
      hh = Math.min(hw * 0.2, 180);
      heartCanvas.width = hw;
      heartCanvas.height = hh;
    }
    resizeHeart();
    window.addEventListener('resize', resizeHeart);

    function drawHeart(ctx, cx, cy, size) {
      ctx.beginPath();
      const x = cx, y = cy;
      const s = size;
      ctx.moveTo(x, y + s * 0.3);
      ctx.bezierCurveTo(x, y - s * 0.1, x - s * 0.5, y - s * 0.4, x - s * 0.5, y - s * 0.1);
      ctx.bezierCurveTo(x - s * 0.5, y + s * 0.15, x, y + s * 0.45, x, y + s * 0.6);
      ctx.bezierCurveTo(x, y + s * 0.45, x + s * 0.5, y + s * 0.15, x + s * 0.5, y - s * 0.1);
      ctx.bezierCurveTo(x + s * 0.5, y - s * 0.4, x, y - s * 0.1, x, y + s * 0.3);
      ctx.closePath();
      ctx.fill();
    }

    function animateHeart() {
      hrt.clearRect(0, 0, hw, hh);

      const size = Math.min(hw * 0.15, 120);
      const cx = hw / 2;
      const cy = hh / 2 - size * 0.15;
      const ox = Math.random() > 0.88 ? (Math.random() - 0.5) * 10 : 0;
      const oy = Math.random() > 0.88 ? (Math.random() - 0.5) * 6 : 0;

      // White base
      hrt.fillStyle = 'rgba(255,255,255,0.9)';
      drawHeart(hrt, cx, cy, size);

      // RGB glitch layers
      hrt.globalCompositeOperation = 'lighter';
      hrt.fillStyle = 'rgba(255,0,0,0.3)';
      drawHeart(hrt, cx - 3 + ox, cy + oy, size);
      hrt.fillStyle = 'rgba(0,255,0,0.15)';
      drawHeart(hrt, cx + ox, cy + oy, size);
      hrt.fillStyle = 'rgba(0,100,255,0.3)';
      drawHeart(hrt, cx + 3 + ox, cy + oy, size);
      hrt.globalCompositeOperation = 'source-over';

      // Glitch slices
      if (Math.random() > 0.7) {
        for (let i = 0; i < 2; i++) {
          const sy = Math.random() * hh;
          const sh = Math.random() * 20 + 5;
          const shift = (Math.random() - 0.5) * 30;
          try {
            const slice = hrt.getImageData(0, sy, hw, sh);
            hrt.putImageData(slice, shift, sy);
          } catch(e) {}
        }
      }


      requestAnimationFrame(animateHeart);
    }
    animateHeart();
  }

  // Why are you here? buttons
  const whyButtons = document.querySelectorAll('.why-btn');
  const whyReply = document.getElementById('why-here-reply');
  whyButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const reply = btn.getAttribute('data-reply') || '';
      if (whyReply) {
        whyReply.innerHTML = reply;
        whyReply.classList.add('visible');
      }
      whyButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Refresh ScrollTrigger after videos/fonts load to fix position calculations
  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
  });

</script>

<style>
  /* ── HERO ── */
  .hero {
    width: 100%;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(8rem, 20vh, 16rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    width: 100%;
    max-width: 1100px;
    padding: 0 2rem;
  }

  .hero-title {
    font-family: 'TurboDriver', 'TerminalGrotesque', sans-serif;
    font-size: clamp(2rem, 7vw, 5.5rem);
    font-weight: normal;
    color: #fff;
    text-align: center;
    letter-spacing: 0.15em;
    line-height: 1.3;
    overflow: visible;
    display: none;
  }

  .title-line {
    display: block;
    opacity: 0;
  }

  #hero-glitch-canvas {
    width: 100%;
    display: block;
  }

  /* ── VIBE SLIDER ── */
  .vibe-slider-wrap {
    width: 100%;
    max-width: 400px;
    margin: 1.5rem auto 0;
