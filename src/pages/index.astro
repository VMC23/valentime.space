---
import Layout from '../layouts/MainLayout.astro';

const title = "Valentine Brasser — Video & Vermittlung";
const description = "Video & Vermittlung";
---

<Layout title={title} description={description}>

  <!-- HERO: full-viewport background video -->
  <section class="hero">
    <video src="/ResistanceIsKey.mp4" autoplay loop muted playsinline class="hero-video"></video>
    <div class="hero-overlay"></div>
    <div class="hero-content" id="hero-title">
      <h1 class="hero-title">Video &<br>Vermittlung</h1>
    </div>
    <p class="hero-caption" id="hero-caption">Resistance Is Key — Zurich, 2026</p>
    <div class="hero-scroll-hint" id="scroll-hint">
      <span>&darr;</span>
    </div>
  </section>

  <!-- WELCOME -->
  <section class="welcome-section" data-anim>
    <p class="welcome-text">Willkommen &lt;3</p>
  </section>

  <!-- PROJECT: Decolonial -->
  <section class="project-section" data-anim>
    <div class="project-full">
      <div class="project-video-wrap">
        <video src="/Decolonial Website Vid.mov" autoplay loop muted playsinline class="project-video"></video>
      </div>
      <p class="project-caption">Performance und Video, Diversity Politics and the Arts: Post-colonial Perspectives, 2026.</p>
    </div>
  </section>

  <!-- PROJECT: Moods -->
  <section class="project-section" data-anim>
    <div class="project-bleed">
      <video src="/Moods_Video.mp4" autoplay loop muted playsinline class="project-video-bleed"></video>
      <p class="project-caption">Ali Dada, Moods, 2025.</p>
    </div>
  </section>

  <!-- PROJECT: Blob Berlin -->
  <section class="project-section" data-anim>
    <div class="project-full">
      <div class="project-video-wrap">
        <video src="/Blob Berlin Video.mp4" autoplay loop muted playsinline class="project-video"></video>
      </div>
      <p class="project-caption">Blob, hergestellt mit den Besucher:innen auf der documenta fifteen, mit: Kollektiv Loom Loop.<br>Video: Berlin, 2023.</p>
    </div>
  </section>

  <!-- SLIDESHOW: WDC Photos -->
  <section class="project-section slideshow-section" data-anim>
    <div class="slideshow-wrap">
      <div class="slideshow" id="slideshow">
        <img src="/220930_WDC_BadHomburg_ValentineBrasser_6388.jpg" alt="WDC Photo 1" class="slide active">
        <img src="/220930_WDC_BadHomburg_ValentineBrasser_6422-1.jpg" alt="WDC Photo 2" class="slide">
        <img src="/WDC_Tour-3_Valentinebrasser.png" alt="WDC Photo 3" class="slide">
      </div>
      <p class="slideshow-caption">Vermittlung und Fotografie: Design for Democracy, Frankfurt 2022.</p>
    </div>
  </section>

</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Hero content fade-in
  gsap.fromTo('#hero-title',
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1.4, ease: 'power3.out', delay: 0.6 }
  );
  gsap.fromTo('#hero-caption',
    { opacity: 0 },
    { opacity: 0.5, duration: 1, ease: 'power2.out', delay: 1.4 }
  );

  // Scroll hint pulse + fade on scroll
  gsap.to('#scroll-hint', {
    opacity: 0,
    scrollTrigger: {
      trigger: '#scroll-hint',
      start: 'top 80%',
      end: 'top 20%',
      scrub: true,
    }
  });

  // Animate each project section
  document.querySelectorAll('[data-anim]').forEach((section) => {
    gsap.fromTo(section,
      { opacity: 0, y: 60 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 85%',
          end: 'top 40%',
          toggleActions: 'play none none none',
        }
      }
    );

    // Slight scale on videos inside
    const video = section.querySelector('video');
    if (video) {
      gsap.fromTo(video,
        { scale: 1.04 },
        {
          scale: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: video,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          }
        }
      );
    }
  });

  // Slideshow crossfade
  const slides = document.querySelectorAll('#slideshow .slide');
  let current = 0;
  if (slides.length > 1) {
    setInterval(() => {
      slides[current].classList.remove('active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('active');
    }, 4000);
  }
</script>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.3) 0%,
      rgba(0,0,0,0.1) 40%,
      rgba(0,0,0,0.5) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    opacity: 0;
  }

  .hero-title {
    font-family: 'TerminalGrotesque', sans-serif;
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: normal;
    color: #fff;
    text-align: center;
    letter-spacing: 0.15em;
    line-height: 1.05;
  }

  .hero-caption {
    position: absolute;
    bottom: 5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.7rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0;
    white-space: nowrap;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: #fff;
    font-size: 1.4rem;
    opacity: 0.5;
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ── WELCOME ── */
  .welcome-section {
    padding: 5rem 2rem;
    text-align: center;
    opacity: 0;
  }

  .welcome-text {
    font-family: 'TerminalGrotesque', sans-serif;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    color: #fff;
    letter-spacing: 0.1em;
  }

  /* ── PROJECT SECTIONS ── */
  .project-section {
    padding: 6rem 0;
    opacity: 0;
  }

  .project-full {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .project-text-side {
    max-width: 680px;
    text-align: center;
  }

  .project-description {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: #00d2ff;
    line-height: 1.7;
    letter-spacing: 0.02em;
  }

  .project-video-wrap {
    width: 100%;
    overflow: hidden;
  }

  .project-video {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Full-bleed variant */
  .project-bleed {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .project-video-bleed {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-caption {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.8rem;
    color: #666;
    text-align: center;
    margin-top: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0 2rem;
  }

  /* ── SLIDESHOW ── */
  .slideshow-section {
    padding: 4rem 0 8rem;
  }

  .slideshow-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .slideshow {
    position: relative;
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
  }

  .slide.active {
    opacity: 1;
  }

  .slideshow-caption {
    font-family: 'OfficeCodePro', sans-serif;
    font-size: 0.8rem;
    color: #666;
    text-align: center;
    margin-top: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .project-section {
      padding: 3rem 0;
    }

    .hero-title {
      font-size: clamp(2.2rem, 12vw, 4rem);
    }

    .project-full {
      padding: 0 1rem;
    }
  }
</style>
